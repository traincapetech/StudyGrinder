# ========================================================
# StudyGrinder Server Environment Variables (.env.example)
# ========================================================

# Server Port
PORT=3001

# MongoDB Connection String (Atlas or Local)
# Example: mongodb+srv://username:password@cluster.mongodb.net/studygrinder?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/studygrinder?retryWrites=true&w=majority
# Alternatively:
MongoDBURI=mongodb+srv://<user>:<password>@cluster.mongodb.net/studygrinder?retryWrites=true&w=majority

# JWT / Auth Secret Key
SECRET_KEY=your_strong_secret_key_here

# Frontend URL (for CORS & redirects)
FRONTEND_URL=https://studygrinder.com

# ========================================================
# Hostinger SMTP Email Configuration (Zero-Fail Delivery)
# ========================================================
# Hostinger SMTP Host (default: smtp.hostinger.com)
SMTP_HOST=smtp.hostinger.com

# Hostinger SMTP Port (465 for SSL, 587 for TLS)
SMTP_PORT=465

# Hostinger Webmail User (e.g. register@studygrinder.com)
EMAIL_USER=register@studygrinder.com

# Hostinger Webmail Password
EMAIL_PASS=your_hostinger_webmail_password

# Target Inbox where registrations are delivered
REGISTRATION_RECEIVER_EMAIL=register@studygrinder.com

# (Optional) Stripe Integration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
