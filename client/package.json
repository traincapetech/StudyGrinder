  "scripts": {
    "start": "craco start",
    "dev": "craco start",
    "prebuild": "node scripts/prepare-build.js && node scripts/generate-sitemap.js",
    "build": "craco build",
    "postbuild": "node scripts/run-react-snap.js",
    "scrape:gipmc": "node scripts/scrape-gipmc-certifications.js",
    "build:production": "node scripts/build-production.js",
    "build:analyze": "npm run build && npm run analyze",
    "optimize-build": "gzip-size build/static/js/*.js && gzip-size build/static/css/*.css",
    "analyze": "source-map-explorer 'build/static/js/*.js'",
    "test": "craco test",
    "eject": "react-scripts eject",
    "preview": "serve -s build -l 3000",
    "clean": "rm -rf build node_modules/.cache"
  },
  "reactSnap": {
    "inlineCss": false,
    "minifyHtml": {
      "collapseWhitespace": true,
      "removeComments": true
    },
    "skipThirdPartyRequests": true,
    "crawl": false,
    "concurrency": 1,
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox",
      "--disable-dev-shm-usage",
      "--no-zygote"
    ],
    "include": [
      "/",
      "/about-us",
      "/our-services",
